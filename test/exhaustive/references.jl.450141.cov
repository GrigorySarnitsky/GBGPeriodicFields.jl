        - # The spectral-domain SCATTER, written from the docstring's sum rather than from the gather's code:
        - # f̂(k) += Σ_p q_p exp(-i k·(x_p - o)), one term per point, accumulated onto the destination.
        8 function ref_spectral_anterpolate(destination, coordinates, values, grid, layout, R, α, β)
        8   shape = size(destination)[1:3]
        8   components = 3^R
        8   (k1, k2, k3), _ = mode_wavenumbers(grid, layout, shape)
       16   flat_destination = reshape(copy(destination), :, components)
        8   flat_values = reshape(values, size(values, 1), components)
     2560   out = zeros(eltype(destination), size(flat_destination))
        8   for (linear, index) in enumerate(CartesianIndices(shape))
     2560     k = (k1[index[1]], k2[index[2]], k3[index[3]])
     2560     for p in axes(coordinates, 1)
    46080       phase = exp(-im * (k[1] * (coordinates[p, 1] - grid.origin[1]) +
        -                          k[2] * (coordinates[p, 2] - grid.origin[2]) +
        -                          k[3] * (coordinates[p, 3] - grid.origin[3])))
    23040       for c in 1:components
    23040         out[linear, c] += flat_values[p, c] * phase
    23040       end
    43520     end
     5112   end
        8   return reshape(α .* out .+ β .* flat_destination, size(destination))
        - end
